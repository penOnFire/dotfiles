# FocalTech c6d5 driver split for libfprint 1.94.9
#
# First copy the implementation files from bin/libfprint-c6d5/ to
# libfprint/drivers/: focaltech_c6d5.c, focaltech_c6d5.h,
# ft9366_engine.c, and ft9366_engine.h. Then apply this manifest patch.
# The vendor matcher itself is not bundled; setup-fingerprint.sh extracts it
# from the official MEGABOOK driver archive in ~/Downloads.

--- a/libfprint/drivers/focaltech.c
+++ b/libfprint/drivers/focaltech.c
@@ -27,6 +27,5 @@
 static const FpIdEntry id_table[] = {
   { .vid = 0x2808, .pid = 0x9e65 },
-  { .vid = 0x2808, .pid = 0xc6d5 },
   { .vid = 0,      .pid = 0 },
 };
--- a/meson.build
+++ b/meson.build
@@ -144,5 +144,6 @@
    'fpcmoc',
    'realtek',
     'focaltech_moc',
     'focaltech',
+    'focaltech_c6d5',
 ]
@@ -171,4 +172,5 @@
    'etes603',
     'focaltech_moc',
     'focaltech',
+    'focaltech_c6d5',
     'nb1010',
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -154,5 +154,7 @@
    'focaltech_moc' :
        [ 'drivers/focaltech_moc/focaltech_moc.c' ],
     'focaltech' :
         [ 'drivers/focaltech.c' ],
+    'focaltech_c6d5' :
+        [ 'drivers/focaltech_c6d5.c', 'drivers/ft9366_engine.c' ],
 }
